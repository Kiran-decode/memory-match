  function normalizedName(name) { return String(name || '').trim() || 'Player'; }
  function progressKey(name) {
    return `tedxMindStage.progress.${normalizedName(name).toLocaleLowerCase()}`;
  }
  function getProgress(name = $('playerName').value) {
    const defaults = { easy: true, medium: false, hard: false };
    try {
